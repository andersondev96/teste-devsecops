            },
            "advisory": "Affected versions of the PyJWT package are vulnerable to an Algorithm Confusion attack due to improper validation of JSON Web Keys (JWKs) when used with HMAC algorithms. The `decode` method in PyJWT fails to distinguish between public keys and secret keys when both symmetric (HMAC) and asymmetric algorithms are allowed, leading to the acceptance of a public key as an HMAC secret. An attacker can exploit this by crafting a token with an HMAC algorithm header and using a public JWK as the secret, allowing them to forge tokens and impersonate users, potentially bypassing authorization controls.",
            "is_transitive": false,
            "published_date": null,
            "fixed_versions": [],
            "closest_versions_without_known_vulnerabilities": [],
